<?xml version="1.0" encoding="utf-8"?>
<!--
    MODO OSCURO: Android usa estos colores en vez de los de values/ cuando el tema es oscuro.
    Mismos nombres que en values/colors.xml, colors_extra.xml y colors_nuevo.xml.
-->
<resources>
    <!-- Fondos -->
    <color name="cream">#16141E</color>
    <color name="card_bg">#221F2D</color>
    <color name="border_soft">#332E44</color>
    <color name="divider">#2C2839</color>

    <!-- Textos -->
    <color name="text_main">#ECECF3</color>
    <color name="text_muted">#9C9CAE</color>
    <color name="text_label">#BDBDCC</color>
    <color name="text_hint">#9A9AAD</color>

    <!-- Fondos suaves de cada color (tarjetas, etiquetas, chips) -->
    <color name="blue_bg">#1D2A3B</color>
    <color name="lilac_bg">#272339</color>
    <color name="pink_bg">#35222C</color>
    <color name="mint_bg">#1B2E28</color>
    <color name="yellow_bg">#302A19</color>
    <color name="red_bg">#3B2122</color>

    <!-- Textos de color (más claros para que se lean sobre fondo oscuro) -->
    <color name="blue_text">#8EBBE8</color>
    <color name="lilac_text">#B6A7F1</color>
    <color name="pink_text">#F2A3BE</color>
    <color name="mint_text">#7FD4B3</color>
    <color name="yellow_text">#E8C866</color>
    <color name="red_text">#F38E8E</color>

    <!-- Otros -->
    <color name="red_pastel">#5A2E30</color>
    <color name="check_border">#55566A</color>
    <color name="chevron">#55566A</color>
    <color name="white_a60">#33FFFFFF</color>

    <!-- Accesibilidad: en modo oscuro el texto lila es claro (8.4:1); el botón se queda igual -->
    <color name="texto_acento">#B6A7F1</color>

    <!-- Cuadritos de ícono en modo oscuro: pastel brillante con el ícono oscuro (contraste ≥ 6:1) -->
    <color name="tile_blue">#A8C8F0</color>
    <color name="tile_lilac">#C4B5E8</color>
    <color name="tile_mint">#B2E4D4</color>
    <color name="tile_pink">#F4B8C8</color>
    <color name="tile_yellow">#FDEEA0</color>
    <color name="tile_red">#F4A6A6</color>
    <color name="icono_blue">#1D3A5F</color>
    <color name="icono_lilac">#3B2C7A</color>
    <color name="icono_mint">#1D4E3F</color>
    <color name="icono_pink">#74213F</color>
    <color name="icono_yellow">#5A4508</color>
    <color name="icono_red">#701C1C</color>

    <!-- Pasteles usados en bordes y rellenos: versión oscura para que no deslumbren -->
    <color name="blue_pastel">#3A5A80</color>
    <color name="lilac_pastel">#4E4385</color>
    <color name="pink_pastel">#7A3F5C</color>
    <color name="mint_pastel">#2F6656</color>
    <color name="yellow_pastel">#6B5A26</color>
    <color name="lilac_on_pastel">#E2DAFB</color>
    <color name="pink_on_pastel">#F8D3E0</color>
</resources>
