<?xml version="1.0" encoding="utf-8"?>
<!-- Calendario mensual: puntos de colores en los días con entregas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            style="@style/App.BackButton"
            android:id="@+id/btnAtras"
            android:contentDescription="@string/volver"
            android:background="@drawable/bg_back_blue"/>
        <TextView
            style="@style/App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/calendario"/>
    </LinearLayout>

    <!-- Todo lo de abajo se desplaza junto: el mes, las clases y las entregas del día -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Tarjeta del mes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_20"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- < Octubre 2026 > -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btnMesAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_filter_off"
                android:contentDescription="@string/mes_anterior"
                android:padding="12dp"
                android:src="@drawable/ic_anterior"
                app:tint="@color/text_label"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/tvMes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:fontFamily="@font/nunito_extrabold"/>
            <ImageView
                android:id="@+id/btnMesSiguiente"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_filter_off"
                android:contentDescription="@string/mes_siguiente"
                android:padding="12dp"
                android:src="@drawable/ic_siguiente"
                app:tint="@color/text_label"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <!-- Lun Mar Mié ... (se llenan desde Java) y las semanas del mes -->
        <LinearLayout
            android:id="@+id/filaDiasSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"/>
        <LinearLayout
            android:id="@+id/gridCalendario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"/>

        <!-- Leyenda: cada estado con su color y su forma (no depende solo del color, WCAG 1.4.1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_estado_pendiente"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:text="@string/ley_pendiente"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                app:drawableStartCompat="@drawable/ic_estado_vencida"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:text="@string/ley_vencida"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                app:drawableStartCompat="@drawable/ic_estado_completada"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:text="@string/ley_completada"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Clases del día elegido (según el horario de cada materia) -->
    <TextView
        android:id="@+id/tvTituloClasesDia"
        style="@style/App.SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:id="@+id/listClasesDia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <!-- Entregas del día elegido -->
    <TextView
        android:id="@+id/tvTituloDia"
        style="@style/App.SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/entregas_hoy"/>
    <TextView
        android:id="@+id/tvSinEntregas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/cal_sin_entregas"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"/>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
