<?xml version="1.0" encoding="utf-8"?>
<!-- DrawerLayout: la pantalla de Inicio + el menú lateral (☰), el mismo de Perfil -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerInicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="88dp">
                <!-- 88dp abajo: al deslizar hasta el final, la última tarjeta queda por encima del botón +
                     (el botón no tapa contenido: WCAG 2.4.11, ítem 20 de la auditoría) -->

                <!-- Barra superior: botón ☰ (menú lateral) y el nombre de la app -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:elevation="3dp"
                        android:contentDescription="@string/menu_abrir"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/app_name"
                        android:textColor="@color/texto_acento"
                        android:textSize="20sp"
                        android:fontFamily="@font/nunito_extrabold"/>
                </LinearLayout>

                <!-- Header: saludo, fecha y foto de perfil -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvSaludo"
                            style="@style/App.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/saludo_cargando"/>
                        <TextView
                            android:id="@+id/tvFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/nunito_regular"/>
                    </LinearLayout>
                    <!-- Botón de perfil: muestra la foto si hay, si no el emoji -->
                    <FrameLayout
                        android:id="@+id/btnPerfilHeader"
                android:contentDescription="@string/perfil_abrir"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_chip_lilac"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/tvAvatarHeader"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_persona"
                            android:padding="12dp"
                            app:tint="@color/texto_acento"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/ivAvatarHeader"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/nav_perfil"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Resumen de hoy: tres tarjetas de colores -->
                <TextView
                    style="@style/App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/resumen_hoy"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/cardClases"
                    android:background="@drawable/bg_tarjeta_azul"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_libro"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvClases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/blue_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <!-- Con letra muy grande se ajusta al ancho de la tarjeta en vez de cortarse -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:text="@string/clases"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:id="@+id/cardPendientes"
                    android:background="@drawable/bg_tarjeta_rosa"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_pendientes"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/pink_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <!-- Con letra muy grande se ajusta al ancho de la tarjeta en vez de cortarse -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:text="@string/pendientes"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:id="@+id/cardCompletadas"
                    android:background="@drawable/bg_tarjeta_menta"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_hecho"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvCompletadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="0"
                        android:textSize="28sp"
                        android:textColor="@color/mint_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <!-- Con letra muy grande se ajusta al ancho de la tarjeta en vez de cortarse -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:text="@string/completadas"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                </LinearLayout>

                <!-- Clases: las de hoy y, debajo, las del siguiente día con clase (se llenan desde Java) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <!-- Título de la sección -->
                    <TextView
                        android:id="@+id/tvTituloClases"
                        style="@style/App.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/clases_titulo_hoy"/>
                    <!-- Abre el calendario (clases y entregas de cualquier día) -->
                    <TextView
                        android:id="@+id/btnVerCalendario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingVertical="4dp"
                        android:paddingStart="8dp"
                        android:text="@string/ver_calendario"
                        android:textColor="@color/texto_acento"
                        android:textSize="13sp"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/listClases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Tareas pendientes -->
                <TextView
                    style="@style/App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/tareas_pendientes"/>
                <LinearLayout
                    android:id="@+id/listPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"/>
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/bottomNav"
            layout="@layout/view_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- FAB "+": abre un diálogo para agregar tarea o materia (bottom 90, right 22, 54x54, radio 18) -->
    <ImageView
        android:id="@+id/fabAddTask"
        android:contentDescription="@string/tarea_nueva"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="90dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_fab"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:outlineSpotShadowColor="#707563C0"
        android:padding="16dp"
        android:src="@drawable/ic_agregar"
        app:tint="@color/white"/>
</FrameLayout>

    <!-- Menú lateral -->
    <include
        android:id="@+id/menuLateral"
        layout="@layout/view_menu_lateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>
</androidx.drawerlayout.widget.DrawerLayout>
