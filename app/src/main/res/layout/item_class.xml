<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_18"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- fondo se tiñe desde Java -->
    <ImageView
        android:id="@+id/tvIcono"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_round_14"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_libro"
        app:tint="@color/text_label"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_main"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_regular"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSalon"
        style="@style/App.Tag"/>
</LinearLayout>
