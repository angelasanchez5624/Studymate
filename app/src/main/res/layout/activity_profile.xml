<?xml version="1.0" encoding="utf-8"?>
<!-- DrawerLayout: la pantalla de Perfil + el menú lateral (☰) que se desliza desde la izquierda -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Header degradado rosa-lila + avatar que sobresale (queda DENTRO del FrameLayout
                 para que se pueda tocar completo, incluido el botón de cámara) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_profile_header"/>
                <!-- Botón ☰: abre el menú lateral (estadísticas y configuración) -->
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_circulo_blanco"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:elevation="3dp"
                    android:contentDescription="@string/menu_abrir"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/texto_acento"
                    android:scaleType="fitCenter"/>
                <!-- Avatar: foto de perfil (o emoji si no hay). Al tocarlo se elige una foto. -->
                <FrameLayout
                    android:id="@+id/avatarPerfil"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_avatar_border"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/tvAvatarEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_persona"
                        android:padding="20dp"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:contentDescription="@string/foto_perfil"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>
                    <!-- Botoncito de cámara abajo a la derecha -->
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_border"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_camara"
                        app:tint="@color/white"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
            </FrameLayout>

            <!-- Nombre y correo: mt 48, mb 16 -->
            <TextView
                android:id="@+id/tvNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textSize="20sp"
                android:textColor="@color/text_main"
                android:fontFamily="@font/nunito_extrabold"/>
            <TextView
                android:id="@+id/tvCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/nunito_regular"/>

            <!-- Tres tarjetas de colores: semestre, materias y tareas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingBottom="4dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_lila"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_escuela"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvStatSemestre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="—"
                        android:textSize="26sp"
                        android:textColor="@color/lilac_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/semestre"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tarjeta_rosa"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_libro"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvStatMaterias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="0"
                        android:textSize="26sp"
                        android:textColor="@color/pink_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/nav_materias"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tarjeta_menta"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_blanco"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_editar"
                        app:tint="@color/texto_acento"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:id="@+id/tvStatTareas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="0"
                        android:textSize="26sp"
                        android:textColor="@color/mint_text"
                        android:fontFamily="@font/nunito_extrabold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/nav_tareas"
                        android:textSize="12sp"
                        android:textColor="@color/text_main"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta de datos: mx 20, mb 20, radio 20 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_20"
                android:elevation="3dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_escuela"
                        app:tint="@color/text_label"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/carrera"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/nunito_regular"/>
                        <TextView
                            android:id="@+id/tvCarrera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/text_main"
                            android:fontFamily="@font/nunito_semibold"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendario"
                        app:tint="@color/text_label"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/semestre"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/nunito_regular"/>
                        <TextView
                            android:id="@+id/tvSemestre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/text_main"
                            android:fontFamily="@font/nunito_semibold"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/bg_divider"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_universidad"
                        app:tint="@color/text_label"
                        android:scaleType="fitCenter"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/universidad"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/nunito_regular"/>
                        <TextView
                            android:id="@+id/tvUniversidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/text_main"
                            android:fontFamily="@font/nunito_semibold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="32dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarPerfil"
                    style="@style/App.Button"
                    android:text="@string/editar_perfil"
                    android:textColor="@color/lilac_on_pastel"
                    android:outlineSpotShadowColor="#60C4B5E8"
                    app:backgroundTint="@color/lilac_pastel"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    style="@style/App.Button"
                    android:layout_marginTop="12dp"
                    android:text="@string/cerrar_sesion"
                    android:textColor="@color/pink_on_pastel"
                    android:outlineSpotShadowColor="#60F4B8C8"
                    app:backgroundTint="@color/pink_pastel"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

    <!-- Menú lateral -->
    <include
        android:id="@+id/menuLateral"
        layout="@layout/view_menu_lateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>
</androidx.drawerlayout.widget.DrawerLayout>
