<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo llegar (dentro de la app): ruta a pie en OpenStreetMap desde tu ubicación hasta el salón -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">
        <ImageView
            style="@style/App.BackButton"
            android:id="@+id/btnAtras"
            android:background="@drawable/bg_back_blue"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                style="@style/App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ruta_titulo"/>
            <TextView
                android:id="@+id/tvDestino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_semibold"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <org.osmdroid.views.MapView
            android:id="@+id/mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Tarjeta con el tiempo y la distancia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_20"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingVertical="8dp">
            <ProgressBar
                android:id="@+id/progresoRuta"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/boton"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tvRutaInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:text="@string/ruta_calculando"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_bold"/>
            <ImageView
                android:id="@+id/btnRecalcular"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ruta_recalcular"
                android:padding="12dp"
                android:src="@drawable/ic_lugar"
                app:tint="@color/texto_acento"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
