<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                style="@style/App.BackButton"
                android:id="@+id/btnAtras"
                android:background="@drawable/bg_back_blue"/>
            <TextView
                android:id="@+id/tvTituloNota"
                style="@style/App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/nota_nueva"/>
        </LinearLayout>

        <!-- Tarjeta del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_20"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/App.Label"
                android:text="@string/nota_nombre"/>
            <EditText
                android:id="@+id/etNombreNota"
                style="@style/App.Input"
                android:hint="@string/nota_nombre_hint"
                android:inputType="textCapSentences"/>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/nota_valor"/>
            <EditText
                android:id="@+id/etNota"
                style="@style/App.Input"
                android:hint="@string/nota_valor_hint"
                android:inputType="numberDecimal"/>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/nota_peso"/>
            <EditText
                android:id="@+id/etPeso"
                style="@style/App.Input"
                android:hint="@string/nota_peso_hint"
                android:inputType="numberDecimal"/>
        </LinearLayout>

        <!-- Vista previa: se actualiza mientras escribes la nota y el porcentaje -->
        <LinearLayout
            android:id="@+id/cardVistaPrevia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_20"
            android:backgroundTint="@color/lilac_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvVistaAcumulado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lilac_text"
                android:textSize="15sp"
                android:fontFamily="@font/nunito_extrabold"/>
            <TextView
                android:id="@+id/tvVistaEvaluado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvVistaMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:fontFamily="@font/nunito_semibold"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarNota"
            style="@style/App.Button"
            android:layout_marginTop="20dp"
            android:text="@string/nota_guardar"
            android:textColor="@color/white"
            android:outlineSpotShadowColor="#607563C0"
            app:backgroundTint="@color/boton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarNota"
            style="@style/App.Button.Outline"
            android:layout_marginTop="12dp"
            android:text="@string/cancelar"/>
    </LinearLayout>
</ScrollView>
