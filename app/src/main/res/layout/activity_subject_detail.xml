<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner: degradado lila, padding 20/20/28/20 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_subject"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">
            <ImageView
                style="@style/App.BackButton"
                android:id="@+id/btnAtras"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_back_glass"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/materia_mayus"
                android:textSize="13sp"
                android:textColor="@color/lilac_text"
                android:fontFamily="@font/nunito_semibold"/>
            <TextView
                android:id="@+id/tvNombreMateria"
                style="@style/App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- Tarjeta Información -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_20"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/informacion"
                    android:textSize="14sp"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/nunito_bold"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <!-- Docente: Nombre -->
                        <TextView
                            android:id="@+id/tvProfesor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/text_main"
                            android:fontFamily="@font/nunito_semibold"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_divider"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_reloj"
                            app:tint="@color/text_label"
                            android:scaleType="fitCenter"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/horario"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted"
                                android:fontFamily="@font/nunito_regular"/>
                            <TextView
                                android:id="@+id/tvHorario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/text_main"
                                android:fontFamily="@font/nunito_semibold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_divider"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lugar"
                            app:tint="@color/text_label"
                            android:scaleType="fitCenter"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/salon"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted"
                                android:fontFamily="@font/nunito_regular"/>
                            <TextView
                                android:id="@+id/tvSalon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/text_main"
                                android:fontFamily="@font/nunito_semibold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_divider"/>
            </LinearLayout>

            <!-- Ubicación de la clase (OpenStreetMap). Solo se ve si la materia tiene ubicación -->
            <LinearLayout
                android:id="@+id/cardUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_20"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ubicacion_clase"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/nunito_bold"/>
                    <TextView
                        android:id="@+id/btnComoLlegar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="@string/como_llegar"
                        android:textColor="@color/texto_acento"
                        android:textSize="13sp"
                        android:fontFamily="@font/nunito_bold"/>
                </LinearLayout>
                <!-- Mapa pequeño: al tocarlo se abre el mapa completo -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_round_14"
                    android:clipToOutline="true">
                    <org.osmdroid.views.MapView
                        android:id="@+id/mapaMateria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <View
                        android:id="@+id/tapaMapa"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Tareas: título y + para agregar una tarea de esta materia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTituloTareas"
                    style="@style/App.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""/>
                <ImageView
                    style="@style/App.PlusButton"
                    android:id="@+id/btnAddTarea"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/listTareasMateria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <TextView
                android:id="@+id/tvSinTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/sin_tareas_ahora"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"/>

            <!-- Apuntes de la materia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTituloApuntes"
                    style="@style/App.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/apuntes"/>
                <ImageView
                    style="@style/App.PlusButton"
                    android:id="@+id/btnAddApunte"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/listApuntes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <TextView
                android:id="@+id/tvSinApuntes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/primer_apunte"
                android:textSize="13sp"
                android:textColor="@color/text_muted"/>

            <!-- Calificaciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/App.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calificaciones"/>
                <ImageView
                    style="@style/App.PlusButton"
                    android:id="@+id/btnAddNota"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_20"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/promedio_ponderado"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/nunito_regular"/>
                <TextView
                    android:id="@+id/tvPromedio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="32sp"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/nunito_extrabold"/>
                <TextView
                    android:id="@+id/tvMensajeNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_label"
                    android:fontFamily="@font/nunito_semibold"/>
                <TextView
                    android:id="@+id/tvPesoEvaluado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/nunito_regular"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/listNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>
            <TextView
                android:id="@+id/tvSinNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/primera_nota"
                android:textSize="13sp"
                android:textColor="@color/text_muted"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarMateria"
                style="@style/App.Button"
                android:layout_marginTop="20dp"
                android:text="@string/materia_editar"
                android:textColor="@color/lilac_on_pastel"
                android:outlineSpotShadowColor="#60C4B5E8"
                app:backgroundTint="@color/lilac_pastel"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
