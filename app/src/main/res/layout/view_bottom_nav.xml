<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior. Se incluye con <include android:id="@+id/bottomNav" layout="@layout/view_bottom_nav"/>
     y se activa con BottomNavHelper.setup(this, BottomNavHelper.INICIO) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_inicio"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_inicio"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/nunito_medium"/>
        <View
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator"
            android:visibility="invisible"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navMaterias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_materias"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_materias"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/nunito_medium"/>
        <View
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator"
            android:visibility="invisible"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navTareas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_tareas"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_tareas"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/nunito_medium"/>
        <View
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator"
            android:visibility="invisible"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_perfil"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_perfil"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/nunito_medium"/>
        <View
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator"
            android:visibility="invisible"/>
    </LinearLayout>
</LinearLayout>
