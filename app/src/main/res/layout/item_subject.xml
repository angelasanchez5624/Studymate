<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardMateria"
    android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_20"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <ImageView
        android:id="@+id/tvIcono"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_round_16"
        android:importantForAccessibility="no"
        android:padding="13dp"
        android:src="@drawable/ic_libro"
        android:tint="@color/text_label"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_main"
            android:fontFamily="@font/nunito_extrabold"/>
        <TextView
            android:id="@+id/tvProfesor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_regular"/>
        <!-- Se usa solo si la materia no tiene horarios -->
        <TextView
            android:id="@+id/tvHorario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:fontFamily="@font/nunito_semibold"/>
        <!-- Un cuadrito por cada horario (item_horario_chip.xml), se llena desde Java -->
        <LinearLayout
            android:id="@+id/listHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical"/>
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_siguiente"
        android:tint="@color/chevron"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
</LinearLayout>
