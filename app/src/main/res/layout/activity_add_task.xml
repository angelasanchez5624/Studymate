<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                style="@style/App.BackButton"
                android:id="@+id/btnAtras"
                android:background="@drawable/bg_back_blue"/>
            <TextView
                android:id="@+id/tvTituloTarea"
                style="@style/App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/tarea_nueva"/>
        </LinearLayout>

        <!-- Tarjeta del formulario: radio 20, padding 20 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_20"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/App.Label"
                android:text="@string/tarea_nombre"/>
            <EditText
                android:id="@+id/etNombreTarea"
                style="@style/App.Input"
                android:hint="@string/tarea_nombre_hint"
                android:inputType="textCapSentences"/>

            <!-- Tipo: Tarea, Examen, Taller, Exposición o Proyecto -->
            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/tipo"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_normal">
                <Spinner
                    android:id="@+id/spTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:dropDownVerticalOffset="52dp"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:popupElevation="6dp"
                    android:spinnerMode="dropdown"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flecha_abajo"
                    android:tint="@color/text_muted"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/materia"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_normal">
                <Spinner
                    android:id="@+id/spMateria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:dropDownVerticalOffset="52dp"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:popupElevation="6dp"
                    android:spinnerMode="dropdown"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flecha_abajo"
                    android:tint="@color/text_muted"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/prioridad"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_normal">
                <Spinner
                    android:id="@+id/spPrioridad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:dropDownVerticalOffset="52dp"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:popupElevation="6dp"
                    android:spinnerMode="dropdown"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flecha_abajo"
                    android:tint="@color/text_muted"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <!-- Fecha y hora de entrega (se abren DatePicker y TimePicker desde Java) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/App.Label"
                        android:text="@string/fecha_entrega"/>
                    <EditText
                        android:id="@+id/etFecha"
                        style="@style/App.Input"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/App.Label"
                        android:text="@string/hora"/>
                    <EditText
                        android:id="@+id/etHora"
                        style="@style/App.Input"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:hint="@string/hora_hint"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="20dp"
                android:text="@string/descripcion"/>
            <EditText
                android:id="@+id/etDescripcion"
                style="@style/App.Input"
                android:gravity="top|start"
                android:hint="@string/descripcion_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:lines="3"
                android:maxLines="5"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarTarea"
            style="@style/App.Button"
            android:layout_marginTop="20dp"
            android:text="@string/tarea_guardar"
            android:textColor="@color/white"
            android:outlineSpotShadowColor="#607563C0"
            app:backgroundTint="@color/boton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarTarea"
            style="@style/App.Button.Outline"
            android:layout_marginTop="12dp"
            android:text="@string/cancelar"/>
    </LinearLayout>
</ScrollView>
