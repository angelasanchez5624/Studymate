<?xml version="1.0" encoding="utf-8"?>
<!-- Mis notas: promedio general y las notas de todas las materias -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                style="@style/App.BackButton"
                android:id="@+id/btnAtras"
                android:background="@drawable/bg_back_blue"/>
            <TextView
                style="@style/App.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/mis_notas"/>
            <!-- + : elegir materia y agregar una nota -->
            <ImageView
                style="@style/App.PlusButton"
                android:id="@+id/btnAddNota"/>
        </LinearLayout>

        <!-- Promedio general -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_20"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promedio_general"
                android:textSize="12sp"
                android:textColor="@color/text_muted"/>
            <TextView
                android:id="@+id/tvPromedioGeneral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="32sp"
                android:textColor="@color/text_main"
                android:fontFamily="@font/nunito_extrabold"/>
            <TextView
                android:id="@+id/tvPromedioDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_muted"/>
        </LinearLayout>

        <!-- Una tarjeta por materia (item_materia_notas.xml) -->
        <LinearLayout
            android:id="@+id/listMaterias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
