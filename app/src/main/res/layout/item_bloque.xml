<?xml version="1.0" encoding="utf-8"?>
<!-- Un horario de la materia: días, horas y salón. Se agrega desde AddSubjectActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical"
    tools:background="@drawable/bg_card_20"
    tools:padding="20dp">

    <View
        android:id="@+id/separadorBloque"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvTituloBloque"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/horario"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/btnQuitarBloque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/quitar"
            android:textColor="@color/pink_text"
            android:textSize="13sp"
            android:fontFamily="@font/nunito_bold"/>
    </LinearLayout>

    <TextView
        style="@style/App.Label"
        android:layout_marginTop="12dp"
        android:text="@string/dias_clase"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="-2dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dia0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_lun"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_mar"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_mie"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_jue"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_vie"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_sab"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/dia6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_off"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/dia_dom"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/nunito_bold"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/App.Label"
                android:text="@string/hora_inicio"/>
            <EditText
                android:id="@+id/etHoraInicio"
                style="@style/App.Input"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/hora_inicio_hint"
                android:inputType="none"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/App.Label"
                android:text="@string/hora_fin"/>
            <EditText
                android:id="@+id/etHoraFin"
                style="@style/App.Input"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/hora_fin_hint"
                android:inputType="none"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        style="@style/App.Label"
        android:layout_marginTop="20dp"
        android:text="@string/salon"/>
    <EditText
        android:id="@+id/etSalon"
        style="@style/App.Input"
        android:hint="@string/salon_hint"
        android:inputType="textCapCharacters"/>

    <!-- Ubicación de ESTE salón en el mapa (OpenStreetMap) -->
    <TextView
        style="@style/App.Label"
        android:layout_marginTop="20dp"
        android:text="@string/ubicacion_salon"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnUbicacionBloque"
            android:drawableStart="@drawable/ic_lugar"
            android:drawablePadding="8dp"
            android:drawableTint="@color/texto_acento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_normal"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/elegir_mapa"
            android:textColor="@color/texto_acento"
            android:textSize="14sp"
            android:fontFamily="@font/nunito_bold"/>
        <TextView
            android:id="@+id/btnQuitarUbicacionBloque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/quitar"
            android:textColor="@color/red_text"
            android:textSize="13sp"
            android:fontFamily="@font/nunito_bold"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
